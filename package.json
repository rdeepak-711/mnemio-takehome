{
  "name": "mnemio-takehome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests app vitest.config.ts next.config.ts",
    "format:check": "prettier --check src tests app vitest.config.ts next.config.ts",
    "db:reset": "tsx src/db/reset.ts",
    "seed": "tsx src/seed/run.ts",
    "tick": "tsx src/main.ts run",
    "advance": "tsx src/main.ts advance",
    "ai:warm": "tsx src/main.ts ai:warm",
    "report": "tsx src/main.ts report",
    "full-run": "tsx src/main.ts full-run"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "animejs": "4.5.0",
    "dotenv": "^18.0.8",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
